# Copy to .env (gitignored) — NSMPA loads it automatically and never prints values.
SERPER_API_KEY=
# Optional fallback provider
BRAVE_SEARCH_API_KEY=
# Optional: overrides user_agent from config.yml
# NSMPA_USER_AGENT=NSMPA/0.3 (+https://example.org/nsmpa; contact=research@example.org)
# Optional: AI second opinion (`nsmpa ai-review`), Gemini by default
GEMINI_API_KEY=
# Only if ai_provider: anthropic
ANTHROPIC_API_KEY=
